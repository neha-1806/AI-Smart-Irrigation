# Copy to .env and fill in. Never commit .env.
PORT=3000
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# Neon Postgres connection string (neon.tech). Optional: without it history is kept in memory only.
DATABASE_URL=

# Optional. When set, the ESP32 must send the same value in the X-Device-Key header.
DEVICE_KEY=

# Optional. Extra dashboard URLs allowed by CORS, comma separated.
CORS_ORIGINS=
